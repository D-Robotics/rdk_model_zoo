{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "verification"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "patch_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sample_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository",
        "commit",
        "dirty",
        "patch_sha256",
        "sample_path"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "level": {
            "enum": [
              "static",
              "host",
              "board"
            ]
          },
          "purpose": {
            "enum": [
              "structure",
              "smoke",
              "accuracy",
              "performance",
              "consistency"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run",
              "not-applicable"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_variant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "task": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runtime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "input_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "platform",
              "model_variant",
              "task",
              "runtime",
              "model_sha256",
              "input_sha256"
            ]
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "board": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "os": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runtime_version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "host",
              "board",
              "os",
              "runtime_version"
            ]
          },
          "execution": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exit_code": {
                    "type": "integer"
                  },
                  "started_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ended_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "argv",
                  "cwd",
                  "exit_code",
                  "started_at",
                  "ended_at"
                ]
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptance": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "summary",
                  "acceptance"
                ]
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "required",
          "level",
          "purpose",
          "status",
          "scope",
          "environment",
          "execution",
          "result",
          "evidence",
          "reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "target",
    "checks"
  ]
}
